<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="491.0" prefWidth="600" spacing="20" stylesheets="@/styles/general.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AddOrEditGebruikerFrameController">
    
    <children>
        <Label fx:id="hoofdLabel" alignment="CENTER" maxWidth="Infinity" styleClass="label-header-sub" text="Gebruiker Aanmaken" />

        <GridPane hgap="15" vgap="12">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" />
                <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints valignment="CENTER" />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints maxHeight="22.0" minHeight="15.0" prefHeight="15.0" />
            <RowConstraints />
            <RowConstraints />
            </rowConstraints>

            <!-- Row 0 -->
            <Label styleClass="label-detail-field" text="Voornaam:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="voornaamField" prefWidth="270.0" promptText="Voornaam" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0" />

            <!-- Row 1 -->
            <Label styleClass="label-detail-field" text="Achternaam:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="achternaamField" promptText="Achternaam" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />

            <!-- Row 2 -->
            <Label styleClass="label-detail-field" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="emailField" promptText="E-mailadres" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />

            <!-- Row 3 -->
            <Label styleClass="label-detail-field" text="Gsm Nummer" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="gsmNrField" promptText="GSM" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />

            <!-- Row 4 -->
            <Label styleClass="label-detail-field" text="Straat:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="straatField" promptText="Straatnaam" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField fx:id="huisNrField" promptText="Huisnr" GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <TextField fx:id="postcodeField" promptText="Postcode" GridPane.columnIndex="2" GridPane.rowIndex="5" />

            <!-- Row 7 -->
            <Label styleClass="label-detail-field" text="Stad:" GridPane.rowIndex="5" />
            <TextField fx:id="stadField" promptText="Stad" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <!-- Row 8 -->
            <Label styleClass="label-detail-field" text="Land:" GridPane.rowIndex="6" />
            <TextField fx:id="landField" promptText="Land" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="6" />

            <!-- Row 9 -->
            <Label styleClass="label-detail-field" text="Geboortedatum:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
            <DatePicker fx:id="geboorteDatumPicker" promptText="dd/mm/jjjj" GridPane.columnIndex="1" GridPane.rowIndex="7" />

            <!-- Row 10 -->
            <Label styleClass="label-detail-field" text="Rol:" GridPane.rowIndex="8" />
            <ChoiceBox fx:id="rolBox" prefWidth="140.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />
         <CheckBox fx:id="actiefBox" mnemonicParsing="false" text="Actief" GridPane.columnIndex="2" GridPane.rowIndex="7" />
        </GridPane>
      <FlowPane alignment="CENTER">
         <children>
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#Cancel" style="-fx-pref-width: 130px;" styleClass="cancel" text="Cancel">
               <FlowPane.margin>
                  <Insets right="20.0" />
               </FlowPane.margin>
            </Button>
      
              <Button fx:id="submitBtn" onAction="#addGebruiker" style="-fx-pref-width: 130px;" styleClass="add" text="Toevoegen" />
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </FlowPane>

    </children>
    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>
</VBox>
