<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root
    type="VBox"
    stylesheets="@/styles/general.css"
    styleClass="container-main"
    prefHeight="400.0"
    prefWidth="600.0"
    spacing="10.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <children>
        <Label
            text="Machines Overzicht"
            styleClass="label-header-main">
        </Label>

        <TableView
            fx:id="machineTable"
            prefHeight="450.0"
            VBox.vgrow="NEVER"
            styleClass="table-view-general"
            >
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="150.0" text="Naam" />
                <TableColumn fx:id="locationCol" prefWidth="150.0" text="Locatie" />
                <TableColumn fx:id="statusCol" prefWidth="150.0" text="Status" />
                <TableColumn fx:id="uptimeCol" prefWidth="150.0" text="Uptime" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox
            fx:id="buttonContainer"
            spacing="10.0"
            alignment="CENTER"
            VBox.vgrow="NEVER">
            <children>
                <Button
                    fx:id="addMachineBtn"
                    text="Machine Toevoegen"
                    styleClass="add"
                    />
                <Button
                    fx:id="updateMachineBtn"
                    text="Machine Bewerken"
                    styleClass="edit"
                    />
                <Button
                    fx:id="removeMachineBtn"
                    text="Machine Verwijderen"
                    styleClass="delete"
                    />
                <Button
                    fx:id="addOnderhoudBtn"
                    text="Onderhoud Toevoegen"
                    styleClass="add"
                    />
                <Button
                    fx:id="updateOnderhoudBtn"
                    text="Onderhoud bewerken"
                    styleClass="edit"
                    />
            </children>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HBox>

        <Label
            fx:id="lblStatus"
            text="Geen machine geselecteerd."
            styleClass="label-status"
            />
    </children>
</fx:root>
