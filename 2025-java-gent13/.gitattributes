# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Source files
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.fxml text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Docker & Config
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Binaries
*.jar binary
*.war binary
*.class binary
