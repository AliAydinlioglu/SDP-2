{
    "name": "2025-nodejs-gent13",
    "version": "1.0.0",
    "description": "Backend for the course SDP2.",
    "main": "./out/src/index.js",
    "scripts": {
        "start": "env-cmd ts-node ./src/index.ts --custom-string",
        "startDemon": "env-cmd nodemon ./src/index.ts",
        "test": "env-cmd -f .env.test jest --runInBand",
        "test:coverage": "env-cmd -f .env.test jest --env jsdom --runInBand --coverage",
        "startJS": "env-cmd node ./out/src/index.js --custom-string",
        "serverJS": "node ./out/src/index.js",
        "serverJSReset": "node ./out/src/index.js --custom-string"
    },
    "author": "OGUZ AYDINLIOGLU oguz.aydinlioglu@student.hogent.be, ALI AYDINLIOGLU ali.aydinlioglu@student.hogent.be",
    "license": "MIT",
    "private": true,
    "dependencies": {
        "@koa/cors": "^5.0.0",
        "@koa/router": "^12.0.1",
        "@prisma/client": "^6.4.1",
        "@types/node": "^22.13.5",
        "argon2": "^0.31.2",
        "config": "^3.3.9",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "knex": "^3.0.1",
        "koa": "^2.14.2",
        "koa-body": "^6.0.1",
        "koa-helmet": "^7.0.2",
        "mysql2": "^3.6.3",
        "prisma": "^6.4.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/config": "^3.3.2",
        "@types/jest": "^29.5.10",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/koa": "^2.13.9",
        "@types/koa-bodyparser": "^4.3.12",
        "@types/koa__cors": "^4.0.3",
        "@types/koa__router": "^12.0.3",
        "@types/supertest": "^2.0.16",
        "env-cmd": "^10.1.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jsdom": "^23.0.1",
        "nodemon": "^3.0.1",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "typescript": "^5.3.3"
    },
    "prisma": {
        "schema": "src/data/schema.prisma",
        "seed": "ts-node ./src/data/seeds/seed.ts"
    },
    "nodemonConfig": {
        "signal": "SIGTERM",
        "ignore": [
            "node_modules/*",
            ".vscode/*"
        ],
        "delay": "80",
        "watch": [
            "config",
            "src"
        ],
        "quiet": true,
        "ext": "ts,json",
        "legacyWatch": false,
        "exec": "ts-node ./src/index.ts"
    },
    "engines": {
        "npm": ">=9.8.0",
        "node": ">=20.6.0",
        "yarn": ">=1.22.0"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
