# Environment mode: development, production, test
NODE_ENV=development

# Server port
PORT=9000

# Database configuration
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=Local_SDP2
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# Prisma Database URL
DATABASE_URL="mysql://root:root@mysql:3306/Local_SDP2"

# JWT Secret for authentication (replace with a secure random key)
JWTSECRET=change-me-to-a-secure-random-secret-key-32chars
