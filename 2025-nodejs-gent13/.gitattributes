# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Source files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.prisma text eol=lf

# Docker & Config
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.env* text eol=lf
