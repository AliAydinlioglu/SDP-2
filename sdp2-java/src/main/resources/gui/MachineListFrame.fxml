<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root type="VBox" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="10.0" stylesheets="@../styles/index.css">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <Label text="Machines Overzicht" styleClass="title-label">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TableView fx:id="machineTable" prefHeight="300.0" VBox.vgrow="ALWAYS" styleClass="data-table">
         <columns>
            <TableColumn fx:id="nameCol" prefWidth="150.0" text="Naam" />
            <TableColumn fx:id="locationCol" prefWidth="150.0" text="Locatie" />
            <TableColumn fx:id="statusCol" prefWidth="150.0" text="Status" />
            <TableColumn fx:id="uptimeCol" prefWidth="150.0" text="Uptime" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox spacing="10.0">
         <children>
            <Label fx:id="lblStatus" text="Geen machine geselecteerd." styleClass="status-label" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <VBox spacing="10.0" alignment="CENTER">
            <Button fx:id="addMachineBtn" mnemonicParsing="false" text="Machine Toevoegen" styleClass="primary-button" />
            <Button fx:id="updateMachineBtn" mnemonicParsing="false" text="Machine Bewerken" styleClass="action-button" />
            <Button fx:id="removeMachineBtn" mnemonicParsing="false" text="Machine Verwijderen" styleClass="cancel-button" />
            <Button fx:id="addOnderhoudBtn" mnemonicParsing="false" text="Onderhoud Toevoegen" styleClass="primary-button" />
         </VBox>
      </HBox>
   </children>
</fx:root>
