<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="950.0" spacing="20.0" type="HBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <!-- Left side: Labels, Table, and Back Button -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Button fx:id="btnTerug" text="Terug" />
                <Label text="Site Details">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <Label text="Naam:" />
                                <Label fx:id="lblSiteNaam" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label text="Verantwoordelijke:" />
                                <Label fx:id="lblVerantwoordelijke" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label text="Aantal Machines:" />
                                <Label fx:id="lblAantalMachines" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <TableView fx:id="machineTable" prefHeight="222.0" prefWidth="202.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="naamCol" text="Naam" />
                        <TableColumn fx:id="locatieCol" text="Locatie" />
                        <TableColumn fx:id="statusCol" text="Status" />
                        <TableColumn fx:id="productiestatusCol" text="Productie Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <!-- Right side: Placeholder for other content -->
        <VBox prefHeight="379.0" prefWidth="203.0" spacing="10.0" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="lblMachineDetails" prefHeight="27.0" prefWidth="162.0" text="Machine Details">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets top="36.0" />
               </VBox.margin>
            </Label>
            <VBox spacing="10.0">
               <children>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Naam:" />
                        <Label fx:id="lblMachineNaam" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Code:" />
                        <Label fx:id="lblMachineCode" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Locatie:" />
                        <Label fx:id="lblMachineLoc" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Product:" />
                        <Label fx:id="lblMachineProduct" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Status:" />
                        <Label fx:id="lblMachineStatus" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Productiestatus:" />
                        <Label fx:id="lblMachineProdStatus" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Uptime:" />
                        <Label fx:id="lblMachineUptime" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Technieker:" />
                        <Label fx:id="lblMachineTechnieker" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Laatste onderhoud:" />
                        <Label fx:id="lblLaatsteOnderhoud" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Aantal dagen sinds onderhoud:" />
                        <Label fx:id="lblAantalDagenOnderhoud" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Datum toekomstig onderhoud (indien ingepland):" />
                        <Label fx:id="lblDatumToekomstigOnderhoud" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Button fx:id="btnOnderhoud" mnemonicParsing="false" text="Alle onderhouden" />
         </children>
        </VBox>
    </children>
</fx:root>
