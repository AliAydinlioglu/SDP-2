<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="950.0" spacing="20.0" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Button fx:id="btnTerug" text="Terug" />
                <Label text="Site Details">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <VBox spacing="5.0"> <children>
                        <HBox spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" text="Naam:" />
                                <Label fx:id="lblSiteNaam" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" text="Verantwoordelijke:" />
                                <Label fx:id="lblVerantwoordelijke" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" text="Aantal Machines:" />
                                <Label fx:id="lblAantalMachines" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Label text="Machines op Site">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>
                <TableView fx:id="machineTable" prefHeight="250.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="naamCol" prefWidth="150" text="Naam Machine" />
                        <TableColumn fx:id="locatieCol" prefWidth="100" text="Locatie" />
                        <TableColumn fx:id="statusCol" prefWidth="100" text="Status" />
                        <TableColumn fx:id="productiestatusCol" prefWidth="150" text="Productie Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <VBox prefWidth="350.0" spacing="5.0" style="-fx-border-color: lightgray; -fx-border-width: 0 0 0 1; -fx-padding: 0 0 0 20;" HBox.hgrow="NEVER">
            <children>
                <Label fx:id="lblMachineDetailsHeader" text="Machine Details"> <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" top="5.0" />
                    </VBox.margin>
                </Label>
                <VBox spacing="8.0"> <children>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Naam:" /> <Label fx:id="lblMachineNaam" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Code:" /> <Label fx:id="lblMachineCode" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Locatie:" /> <Label fx:id="lblMachineLoc" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Product Info:" /> <Label fx:id="lblMachineProduct" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Status:" /> <Label fx:id="lblMachineStatus" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Productiestatus:" /> <Label fx:id="lblMachineProdStatus" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Uptime:" /> <Label fx:id="lblMachineUptime" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="100" text="Technieker:" /> <Label fx:id="lblMachineTechnieker" /> </HBox>
                        <Label style="-fx-font-weight: bold; -fx-padding-top: 10;" text="Onderhoudsinformatie:">
                             <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <HBox spacing="10.0"> <Label minWidth="180" text="Laatste onderhoud:" /> <Label fx:id="lblLaatsteOnderhoud" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="180" text="Dagen sinds onderhoud:" /> <Label fx:id="lblAantalDagenOnderhoud" /> </HBox>
                        <HBox spacing="10.0"> <Label minWidth="180" text="Volgend onderhoud:" /> <Label fx:id="lblDatumToekomstigOnderhoud" /> </HBox>
                    </children>
                </VBox>
            <Button fx:id="btnOnderhoud" mnemonicParsing="false" text="Alle onderhouden" />
            </children>
        </VBox>
    </children>
</fx:root>
