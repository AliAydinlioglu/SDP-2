<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="10.0" alignment="TOP_LEFT">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <Label text="Site Details">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblSiteNaam" text="Site Naam: -" />
      <Label fx:id="lblVerantwoordelijke" text="Verantwoordelijke: -" />
      <Label fx:id="lblAantalMachines" text="Aantal Machines: -" />

      <Label text="Machines op deze site:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
      <TableView fx:id="machineTable" prefHeight="200.0" prefWidth="400.0">
        <columns>
          <TableColumn fx:id="locatieCol" prefWidth="150.0" text="Locatie" />
          <TableColumn fx:id="statusCol" prefWidth="120.0" text="Status" />
          <TableColumn fx:id="prodStatusCol" prefWidth="150.0" text="Productie Status" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</fx:root>