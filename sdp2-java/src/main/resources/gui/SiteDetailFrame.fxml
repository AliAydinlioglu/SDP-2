<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root prefHeight="400.0" prefWidth="600.0" spacing="10.0" type="HBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <!-- Left side: Labels, Table, and Back Button -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Button fx:id="btnTerug" text="Terug" />
                <Label text="Site Details">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <Label text="Naam:" />
                                <Label fx:id="lblSiteNaam" style="-fx-font-weight: bold;" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label text="Verantwoordelijke:" />
                                <Label fx:id="lblVerantwoordelijke" style="-fx-font-weight: bold;" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label text="Aantal Machines:" />
                                <Label fx:id="lblAantalMachines" style="-fx-font-weight: bold;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <TableView fx:id="machineTable" prefHeight="222.0" prefWidth="74.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="naamCol" text="Naam" />
                        <TableColumn fx:id="locatieCol" text="Locatie" />
                        <TableColumn fx:id="statusCol" text="Status" />
                        <TableColumn fx:id="productiestatusCol" text="Productie Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <!-- Right side: Placeholder for other content -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Label text="Rechterhelft (voor andere inhoud)" />
            </children>
        </VBox>
    </children>
</fx:root>
