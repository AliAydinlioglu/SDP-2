<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="450.0" spacing="20.0" stylesheets="@/styles/general.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AddOrEditMachineFrameController">
   <children>
      <Label fx:id="hoofdLabel" alignment="CENTER" contentDisplay="CENTER" styleClass="label-header-sub" text="Machine Toevoegen of Bewerken">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.0" minWidth="100.0" prefWidth="147.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="285.0" minWidth="10.0" prefWidth="253.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
        <children>
             <Label styleClass="label-detail-field" text="Naam machine:" GridPane.halignment="LEFT" />
            <TextField fx:id="machineNameField" prefHeight="25.0" prefWidth="272.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label styleClass="label-detail-field" text="Naam site:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cboSite" prefHeight="25.0" prefWidth="273.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label styleClass="label-detail-field" text="Code:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="machineIdField" editable="false" prefHeight="25.0" prefWidth="75.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label styleClass="label-detail-field" text="Locatie:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="machineLocationField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label styleClass="label-detail-field" text="Productinfo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtProductInfo" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label styleClass="label-detail-field" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <ComboBox fx:id="machineStatusComboBox" prefHeight="25.0" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label styleClass="label-detail-field" text="Productiestatus:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <ComboBox fx:id="productionStatusComboBox" prefHeight="25.0" prefWidth="194.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />

            <Label styleClass="label-detail-field" text="Uptime (uren):" GridPane.columnIndex="0" GridPane.rowIndex="7" />
            <Spinner fx:id="spnUptime" prefHeight="25.0" prefWidth="73.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />

            <Label styleClass="label-detail-field" text="Naam technieker:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
            <ComboBox fx:id="cboTechnician" prefHeight="25.0" prefWidth="178.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />

            <Label prefHeight="17.0" prefWidth="209.0" styleClass="label-detail-field" text="Laatste onderhoud:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
            <HBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="9">
                <children>
                    <Label fx:id="lblLastMaintenanceDate" />
                    <Hyperlink fx:id="hlLastMaintenanceDetails" prefHeight="23.0" prefWidth="46.0" text="details" />
                </children>
            </HBox>

            <Label prefHeight="17.0" prefWidth="325.0" styleClass="label-detail-field" text="Dagen sinds onderhoud:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
            <Label fx:id="lblDaysSinceMaintenance" GridPane.columnIndex="1" GridPane.rowIndex="10" />

            <Label prefHeight="17.0" prefWidth="211.0" styleClass="label-detail-field" text="Volgend onderhoud:" GridPane.columnIndex="0" GridPane.rowIndex="11" />
            <DatePicker fx:id="dpVolgendOnderhoud" prefHeight="25.0" prefWidth="112.0" GridPane.columnIndex="1" GridPane.rowIndex="11" />
        </children>
      </GridPane>

      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="btnAnnuleren" alignment="CENTER" contentDisplay="CENTER" onAction="#handleAnnuleren" style="-fx-pref-width: 120px;" styleClass="cancel" text="Annuleren" />
            <Button fx:id="btnOpslaan" alignment="CENTER" contentDisplay="CENTER" onAction="#handleOpslaan" style="-fx-pref-width: 120px;" styleClass="add" text="Opslaan" />
         </children>
      </HBox>
   </children>

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
