<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root type="javafx.scene.layout.HBox" styleClass="site-view-container" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="950.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <children>
        <HBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Button fx:id="btnTerug" text="Terug" styleClass="site-button"/>
                <Label text="Machine Details" styleClass="site-main-header-label site-detail-main-header">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>
                <VBox spacing="5.0">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" text="Naam:" styleClass="site-detail-field-label"/>
                                <Label fx:id="lblMachineNaam" styleClass="site-detail-value-label"/>
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" text="Code:" styleClass="site-detail-field-label"/>
                                <Label fx:id="lblMachineCode" styleClass="site-detail-value-label"/>
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" text="Locatie:" styleClass="site-detail-field-label"/>
                                <Label fx:id="lblMachineLoc" styleClass="site-detail-value-label"/>
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" text="Status:" styleClass="site-detail-field-label"/>
                                <Label fx:id="lblMachineStatus" styleClass="site-detail-value-label"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Label text="Machines op Site" styleClass="site-subheader-label site-detail-main-header">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Label>
                <TableView fx:id="machineTable" prefHeight="250.0" VBox.vgrow="ALWAYS" styleClass="machine-detail-table">
                    <columns>
                        <TableColumn fx:id="naamCol" prefWidth="150" text="Naam Machine"/>
                        <TableColumn fx:id="locatieCol" prefWidth="100" text="Locatie"/>
                        <TableColumn fx:id="statusCol" prefWidth="100" text="Status"/>
                        <TableColumn fx:id="productiestatusCol" prefWidth="150" text="Productie Status"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </HBox>

        <HBox prefWidth="350.0" spacing="5.0" style="-fx-border-color: lightgray; -fx-border-width: 0 0 0 1; -fx-padding: 0 0 0 20;" HBox.hgrow="NEVER">
            <children>
                <Label fx:id="lblMachineDetailsHeader" text="Machine Details" styleClass="site-main-header-label site-detail-main-header">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" top="5.0"/>
                    </VBox.margin>
                </Label>
                <VBox spacing="8.0">
                    <children>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Naam:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineNaam" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Code:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineCode" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Locatie:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineLoc" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Product Info:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineProduct" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Status:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineStatus" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Productiestatus:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineProdStatus" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Uptime:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineUptime" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Technieker:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblMachineTechnieker" styleClass="site-detail-value-label"/>
                        </HBox>
                        <Label style="-fx-font-weight: bold; -fx-padding-top: 10;" text="Onderhoudsinformatie:" styleClass="site-detail-field-label">
                            <VBox.margin>
                                <Insets top="5.0"/>
                            </VBox.margin>
                        </Label>
                        <HBox spacing="10.0">
                            <Label minWidth="180" text="Aantal dagen sins laatste onderhoud:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblDagenSindsLaatsteOnderhoud" styleClass="site-detail-value-label"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="180" text="Volgend onderhoud:" styleClass="site-detail-field-label"/>
                            <Label fx:id="lblVolgendOnderhoud" styleClass="site-detail-value-label"/>
                        </HBox>
                    </children>
                </VBox>
                <Button fx:id="btnOnderhoud" styleClass="site-button" mnemonicParsing="false" text="Alle onderhouden"/>
            </children>
        </HBox>
    </children>
</fx:root>
