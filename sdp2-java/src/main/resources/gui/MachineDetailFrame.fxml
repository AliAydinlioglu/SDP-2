<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root type="javafx.scene.layout.HBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="950.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <children>
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Button fx:id="btnTerug" text="Terug" styleClass="back"/>
                <Label text="Machines op Site" styleClass="label-header-main">
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Label>
                <TableView fx:id="machineTable" prefHeight="250.0" VBox.vgrow="ALWAYS" styleClass="table-view-general">
                    <columns>
                        <TableColumn fx:id="naamCol" prefWidth="150" text="Naam Machine"/>
                        <TableColumn fx:id="locatieCol" prefWidth="100" text="Locatie"/>
                        <TableColumn fx:id="statusCol" prefWidth="100" text="Status"/>
                        <TableColumn fx:id="productiestatusCol" prefWidth="150" text="Productie Status"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <HBox prefWidth="450.0" spacing="5.0" style="-fx-border-color: lightgray; -fx-border-width: 0 0 0 1; -fx-padding: 0 0 0 20;" HBox.hgrow="NEVER">
            <children>
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblMachineDetailsHeader" text="Machine Details" styleClass="label-header-main">
                            <VBox.margin>
                                <Insets bottom="10.0" top="5.0"/>
                            </VBox.margin>
                        </Label>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Naam:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineNaam" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Code:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineCode" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Locatie:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineLoc" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Product Info:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineProduct" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Status:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineStatus" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Productiestatus:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineProdStatus" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Uptime:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineUptime" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="100" text="Technieker:" styleClass="label-detail-field"/>
                            <Label fx:id="lblMachineTechnieker" styleClass="label-detail-value"/>
                        </HBox>
                        <Label style="-fx-font-weight: bold; -fx-padding-top: 10;" text="Onderhoudsinformatie:" styleClass="label-header-sub">
                            <VBox.margin>
                                <Insets top="5.0"/>
                            </VBox.margin>
                        </Label>
                        <HBox spacing="10.0">
                            <Label minWidth="180" text="Aantal dagen sins laatste onderhoud:" styleClass="label-detail-field"/>
                            <Label fx:id="lblDagenSindsLaatsteOnderhoud" styleClass="label-detail-value"/>
                        </HBox>
                        <HBox spacing="10.0">
                            <Label minWidth="180" text="Volgend onderhoud:" styleClass="label-detail-field"/>
                            <Label fx:id="lblVolgendOnderhoud" styleClass="label-detail-value"/>
                        </HBox>
                        <Label text="Onderhoudsgeschiedenis:" styleClass="label-detail-field">
                            <VBox.margin>
                                <Insets top="15.0" bottom="5.0"/>
                            </VBox.margin>
                        </Label>
                        <TableView fx:id="onderhoudTable" prefHeight="200.0" VBox.vgrow="ALWAYS" styleClass="table-view-general">
                            <columns>
                                <TableColumn fx:id="onderhoudDatumCol" prefWidth="100.0" text="Datum"/>
                                <TableColumn fx:id="onderhoudStatusCol" prefWidth="100.0" text="Status"/>
                                <TableColumn fx:id="onderhoudTechniekerCol" prefWidth="120.0" text="Technieker"/>
                                <TableColumn fx:id="onderhoudRedenCol" prefWidth="150.0" text="Reden"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                        <Button fx:id="btnOnderhoud" styleClass="general" mnemonicParsing="false" text="Alle onderhouden" style="-fx-pref-width: 120px;">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</fx:root>
