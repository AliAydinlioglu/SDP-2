<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="gui.OnderhoudDetailFrameController" hgap="10" vgap="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Onderhoud Details" style="-fx-font-size: 16px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

    <Label text="Datum uitgevoerd:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <Label fx:id="lblDatum" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Starttijdstip:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <Label fx:id="lblStartTijd" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Eindtijdstip:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <Label fx:id="lblEindTijd" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <Label text="Naam technieker:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <Label fx:id="lblTechnieker" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

    <Label text="Reden:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
    <Label fx:id="lblReden" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

    <Label text="Onderhoudsrapport:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
    <Label fx:id="lblRapport" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

    <Label text="Opmerkingen:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
    <Label fx:id="lblOpmerkingen" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

    <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
    <Label fx:id="lblStatus" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
    
    <Label text="Machine:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
    <Label fx:id="lblMachine" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
</GridPane>
