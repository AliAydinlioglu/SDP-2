<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<fx:root prefHeight="301.0" prefWidth="399.0" type="AnchorPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="LoginLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="101.0" layoutY="27.0" prefHeight="76.0" prefWidth="198.0" text="Login">
         <font>
            <Font size="47.0" />
         </font>
      </Label>
      <Label fx:id="emailLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="84.0" layoutY="113.0" prefHeight="17.0" prefWidth="34.0" text="email:" />
      <TextField fx:id="emailField" layoutX="119.0" layoutY="108.0" prefHeight="26.0" prefWidth="162.0" promptText="someone@example.com" text="geralt@gmail.com" />
      <Label fx:id="wachtwoordLabel" layoutX="49.0" layoutY="164.0" text="wachtwoord: " />
      <PasswordField fx:id="wachtwoordField" layoutX="120.0" layoutY="162.0" prefHeight="23.0" prefWidth="161.0" promptText="wachtwoord" text="12345678" />
      <Button fx:id="submitBtn" layoutX="173.0" layoutY="202.0" mnemonicParsing="false" onAction="#LogIn" text="Login" />
      <Label fx:id="emailError" layoutX="281.0" layoutY="108.0" prefHeight="26.0" prefWidth="112.0" textFill="RED" />
      <Label fx:id="wachtwoordError" layoutX="281.0" layoutY="162.0" prefHeight="26.0" prefWidth="112.0" textFill="RED" />
   </children>
</fx:root>
